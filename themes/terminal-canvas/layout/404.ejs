<% var english = is_english(); %>
<section class="error-page shell narrow-shell">
  <div class="error-code" aria-hidden="true">404</div>
  <span class="eyebrow">ROUTE_NOT_FOUND</span>
  <h1><%= english ? 'Nothing was found at this path.' : '这条路径没有留下内容。' %></h1>
  <p><%= english ? 'The page may have moved, the link may be incorrect, or it has not been written yet.' : '页面可能已经移动、链接可能拼错，或者它还没被写出来。' %></p>
  <div class="error-terminal" aria-label="<%= english ? 'Error details' : '错误详情' %>">
    <code><span>$</span> resolve --path "<%= page.path || '/' %>"</code>
    <code><span>!</span> no matching document found</code>
  </div>
  <div class="hero-actions">
    <a class="button button-primary" href="<%= url_for(english ? '/' : '/zh/') %>"><%= english ? 'Back home' : '返回首页' %> <span aria-hidden="true">→</span></a>
    <a class="button button-quiet" href="<%= url_for(english ? '/en/archives/' : '/archives/') %>"><%= english ? 'Browse archive' : '浏览归档' %></a>
  </div>
</section>

