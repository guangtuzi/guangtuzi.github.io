<%
  var english = is_english();
  var profile = theme.profile || {};
  var navItems = english ? (theme.nav_en || []) : (theme.nav || []);
  var brandName = english
    ? (profile.name_en || config.title_en || config.author_en || config.title || 'Terminal Canvas')
    : (profile.name || config.title || config.author || 'Terminal Canvas');
  var brandRole = profile.role || 'Technical Notes';
  var homePath = english ? '/en/' : '/';
  var alternatePath = page.translation || (english ? '/' : '/en/');
  if (!page.translation && !english && /^archives(?:\/|$)/i.test(String(page.path || ''))) alternatePath = '/en/archives/';
%>
<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href="<%= url_for(homePath) %>" aria-label="<%= brandName %><%= english ? ', back to home' : '，返回首页' %>">
      <span class="brand-mark" aria-hidden="true"><span>&gt;</span>_</span>
      <span class="brand-copy">
        <strong><%= brandName %></strong>
        <span><%= brandRole %></span>
      </span>
    </a>

    <div class="header-actions">
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="<%= english ? 'Switch color theme' : '切换配色' %>" title="<%= english ? 'Switch color theme' : '切换配色' %>">
        <span class="theme-icon" data-theme-icon aria-hidden="true">◐</span>
      </button>
      <button class="icon-button nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-navigation">
        <span class="sr-only"><%= english ? 'Open navigation' : '打开导航' %></span>
        <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>

    <nav class="site-nav" id="site-navigation" data-site-nav aria-label="<%= english ? 'Main navigation' : '主导航' %>">
      <% navItems.forEach(function (item) { var active = nav_active(item.path, page.path); %>
        <a href="<%= url_for(item.path) %>"<% if (active) { %> class="is-active" aria-current="page"<% } %>><%= item.label %></a>
      <% }); %>
      <a class="language-switch" href="<%= url_for(alternatePath) %>" lang="<%= english ? 'zh-CN' : 'en' %>" hreflang="<%= english ? 'zh-CN' : 'en' %>"><%= english ? '中文' : 'EN' %></a>
    </nav>
  </div>
</header>
