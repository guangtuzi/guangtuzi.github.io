<form
  class="site-search"
  role="search"
  data-site-search
  data-search-index="<%= url_for('/search.json') %>"
  data-search-language="<%= english ? 'en' : 'zh-CN' %>"
>
  <label class="sr-only" for="site-search-input"><%= english ? 'Search articles' : '搜索文章' %></label>
  <div class="search-field">
    <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
    <input
      id="site-search-input"
      type="search"
      inputmode="search"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="<%= english ? 'Search articles…' : '搜索文章…' %>"
      aria-controls="site-search-results"
      aria-expanded="false"
      data-search-input
    >
    <button class="search-clear" type="button" aria-label="<%= english ? 'Clear search' : '清除搜索' %>" data-search-clear hidden>
      <span aria-hidden="true">×</span>
    </button>
    <kbd class="search-shortcut" aria-hidden="true">/</kbd>
  </div>

  <div class="search-results" id="site-search-results" data-search-results hidden>
    <div class="search-results-head">
      <p class="search-status" role="status" aria-live="polite" data-search-status></p>
      <label class="search-language-toggle">
        <input type="checkbox" data-search-all-languages>
        <span><%= english ? 'All languages' : '全部语言' %></span>
      </label>
    </div>
    <ul class="search-result-list" data-search-list></ul>
  </div>
</form>
