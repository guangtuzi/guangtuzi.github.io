<article class="standalone-page shell narrow-shell">
  <header class="page-heading">
    <span class="eyebrow"><%= page.eyebrow || 'PAGE' %></span>
    <h1><%= page.title %></h1>
    <% if (page.description) { %><p><%= page.description %></p><% } %>
  </header>
  <div class="post-content standalone-content">
    <%- page.content %>
  </div>
</article>
